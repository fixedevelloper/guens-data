# Copier en .env puis remplacer TOUTES les valeurs (ne jamais committer .env).
DB_ROOT_PASSWORD=change-me
DB_USER=fieldcollect
DB_PASSWORD=change-me
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (clé AES-256 : ne plus la changer une fois des données écrites)
AES_KEY_BASE64=
# openssl rand -base64 24   (ne plus le changer : sert à la détection de doublons)
HASH_PEPPER=
ADMIN_USER=admin
ADMIN_PASSWORD=
CORS_ORIGINS=https://dashboard.example.com
# Stockage MinIO des images de pièces et signatures (objets chiffrés AES côté API)
MINIO_ACCESS_KEY=
# 8 caractères minimum
MINIO_SECRET_KEY=
MINIO_BUCKET=field-collect
